<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#050a13">
  <title>Lunar - Voice Assistant</title>
  <style>
    :root {
      color-scheme: dark;
      --ink: #e9fbff;
      --muted: #7796a7;
      --cyan: #67eaff;
      --blue: #458dff;
      --violet: #9f74ff;
      --glass: rgba(9, 23, 38, .68);
      --line: rgba(113, 222, 255, .19);
      --accent-rgb: 103, 234, 255;
      --blue-rgb: 69, 141, 255;
      --violet-rgb: 159, 116, 255;
      --bg-glow-one: rgba(18, 96, 139, .2);
      --bg-glow-two: rgba(32, 68, 132, .17);
      --bg-glow-three: rgba(95, 38, 143, .13);
      --ambient-glow: rgba(39, 179, 220, .105);
      --grid-line: rgba(63, 193, 255, .3);
    }

    body[data-theme="amethyst"] {
      --ink: #f2eaff;
      --muted: #ab97c2;
      --cyan: #d1a5ff;
      --blue: #9670ff;
      --violet: #ff8bc6;
      --glass: rgba(20, 15, 38, .72);
      --line: rgba(195, 157, 255, .22);
      --accent-rgb: 209, 165, 255;
      --blue-rgb: 150, 112, 255;
      --violet-rgb: 255, 139, 198;
      --bg-glow-one: rgba(110, 51, 154, .22);
      --bg-glow-two: rgba(71, 47, 139, .2);
      --bg-glow-three: rgba(132, 36, 113, .16);
      --ambient-glow: rgba(174, 103, 255, .14);
      --grid-line: rgba(196, 143, 255, .3);
    }

    body[data-theme="emerald"] {
      --ink: #e6fff5;
      --muted: #82b6a2;
      --cyan: #6cf0bd;
      --blue: #32c9a6;
      --violet: #7cc7ff;
      --glass: rgba(7, 29, 29, .72);
      --line: rgba(108, 240, 189, .2);
      --accent-rgb: 108, 240, 189;
      --blue-rgb: 50, 201, 166;
      --violet-rgb: 124, 199, 255;
      --bg-glow-one: rgba(17, 117, 91, .22);
      --bg-glow-two: rgba(18, 77, 81, .19);
      --bg-glow-three: rgba(30, 104, 93, .14);
      --ambient-glow: rgba(53, 218, 165, .13);
      --grid-line: rgba(95, 237, 186, .28);
    }

    body[data-theme="amber"] {
      --ink: #fff5e5;
      --muted: #b9a083;
      --cyan: #ffd17c;
      --blue: #ff9a66;
      --violet: #ff83a1;
      --glass: rgba(34, 23, 16, .72);
      --line: rgba(255, 200, 116, .21);
      --accent-rgb: 255, 209, 124;
      --blue-rgb: 255, 154, 102;
      --violet-rgb: 255, 131, 161;
      --bg-glow-one: rgba(139, 76, 24, .21);
      --bg-glow-two: rgba(111, 54, 34, .18);
      --bg-glow-three: rgba(122, 45, 55, .15);
      --ambient-glow: rgba(255, 174, 68, .13);
      --grid-line: rgba(255, 197, 109, .27);
    }

    * { box-sizing: border-box; }

    html, body { min-height: 100%; }

    body {
      margin: 0;
      min-height: 100vh;
      overflow-x: hidden;
      color: var(--ink);
      background:
        radial-gradient(ellipse at 50% 46%, var(--bg-glow-one), transparent 34%),
        radial-gradient(ellipse at 15% 14%, var(--bg-glow-two), transparent 36%),
        radial-gradient(ellipse at 90% 82%, var(--bg-glow-three), transparent 34%),
        #050a13;
      font-family: "Segoe UI", Inter, system-ui, sans-serif;
      letter-spacing: .025em;
    }

    body::before {
      position: fixed;
      inset: 0;
      z-index: -2;
      content: "";
      opacity: .45;
      background-image:
        radial-gradient(1px 1px at 8% 22%, #b8f8ff 98%, transparent),
        radial-gradient(1px 1px at 74% 15%, #92dbff 98%, transparent),
        radial-gradient(1px 1px at 43% 76%, #a5ceff 98%, transparent),
        radial-gradient(1px 1px at 88% 55%, #9cefff 98%, transparent),
        radial-gradient(1.5px 1.5px at 26% 63%, #fff 98%, transparent),
        radial-gradient(1px 1px at 63% 91%, #c3aeff 98%, transparent);
      background-size: 370px 310px;
    }

    .floor-grid {
      position: fixed;
      z-index: -1;
      right: -20%;
      bottom: -46vh;
      left: -20%;
      height: 76vh;
      opacity: .22;
      transform: perspective(300px) rotateX(63deg);
      transform-origin: center top;
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 54px 54px;
      mask-image: linear-gradient(to bottom, transparent, #000 15%, #000 70%, transparent);
    }

    .ambient-light {
      position: fixed;
      z-index: -1;
      top: 23%;
      left: 50%;
      width: min(68vw, 920px);
      aspect-ratio: 1;
      border-radius: 50%;
      pointer-events: none;
      transform: translate(-50%, -10%);
      background: radial-gradient(circle, var(--ambient-glow), transparent 67%);
      filter: blur(20px);
    }

    .interface {
      width: min(1480px, 100%);
      min-height: 100vh;
      margin: 0 auto;
      padding: 28px clamp(18px, 4vw, 58px) 24px;
      display: flex;
      flex-direction: column;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 56px;
      border-bottom: 1px solid rgba(125, 216, 245, .15);
    }

    .brand { display: flex; align-items: center; gap: 13px; }

    .brand-mark {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(var(--accent-rgb), .62);
      border-radius: 50%;
      color: var(--cyan);
      font-size: 12px;
      box-shadow: 0 0 22px rgba(var(--accent-rgb), .16), inset 0 0 12px rgba(var(--accent-rgb), .12);
    }

    .brand-name { font-size: 12px; font-weight: 700; letter-spacing: .26em; }
    .brand-sub { margin-top: 4px; color: var(--muted); font-size: 8px; letter-spacing: .2em; }

    .link-status {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #9bc5d2;
      font-size: 9px;
      letter-spacing: .18em;
    }

    .link-dot, .small-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #60f7d0;
      box-shadow: 0 0 12px #60f7d0;
    }

    .content {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(180px, 1fr) minmax(380px, 1.55fr) minmax(180px, 1fr);
      align-items: center;
      gap: clamp(22px, 4vw, 62px);
      padding: 28px 0 22px;
    }

    .side-panel {
      position: relative;
      padding: 20px 18px;
      border: 1px solid var(--line);
      background: linear-gradient(145deg, var(--glass), rgba(5, 14, 26, .46));
      box-shadow: 0 18px 56px rgba(0, 0, 0, .19), inset 0 0 32px rgba(53, 180, 218, .025);
      backdrop-filter: blur(14px);
    }

    .side-panel::before, .side-panel::after {
      position: absolute;
      width: 17px;
      height: 17px;
      content: "";
      border-color: rgba(103, 234, 255, .74);
    }

    .side-panel::before { top: -1px; left: -1px; border-top: 1px solid; border-left: 1px solid; }
    .side-panel::after { right: -1px; bottom: -1px; border-right: 1px solid; border-bottom: 1px solid; }

    .eyebrow {
      margin: 0;
      color: var(--cyan);
      font-size: 8px;
      font-weight: 700;
      letter-spacing: .22em;
      text-transform: uppercase;
    }

    .panel-heading {
      margin: 11px 0 24px;
      color: #d8f6ff;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: .15em;
    }

    .metric {
      padding: 14px 0;
      border-top: 1px solid rgba(125, 216, 245, .11);
    }

    .metric-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .metric-label { color: var(--muted); font-size: 8px; letter-spacing: .13em; text-transform: uppercase; }
    .metric-value { color: #e6fbff; font-size: 10px; letter-spacing: .09em; }
    .metric-value.live { color: #74f5d2; }

    .signal-bars { height: 20px; display: flex; align-items: end; gap: 4px; margin-top: 11px; }
    .signal-bars i { width: 4px; height: 5px; border-radius: 3px; background: rgba(95, 221, 255, .54); }
    .signal-bars i:nth-child(2) { height: 9px; }
    .signal-bars i:nth-child(3) { height: 14px; }
    .signal-bars i:nth-child(4) { height: 8px; }
    .signal-bars i:nth-child(5) { height: 18px; }
    .signal-bars i:nth-child(6) { height: 11px; }
    .signal-bars i:nth-child(7) { height: 16px; }
    .signal-bars i:nth-child(8) { height: 7px; }
    .signal-bars i:nth-child(9) { height: 12px; }
    .signal-bars i:nth-child(10) { height: 5px; }

    .capability-list { display: grid; gap: 12px; margin-top: 18px; }
    .capability { display: flex; align-items: center; gap: 9px; color: #91aebe; font-size: 9px; letter-spacing: .07em; }
    .capability .small-dot { width: 5px; height: 5px; background: var(--cyan); box-shadow: 0 0 9px rgba(103, 234, 255, .85); }

    .core-section { min-width: 0; text-align: center; }

    .core-title {
      margin: 11px 0 6px;
      color: #effcff;
      font-size: clamp(27px, 4vw, 48px);
      font-weight: 300;
      letter-spacing: .29em;
      text-shadow: 0 0 25px rgba(103, 234, 255, .18);
    }

    .core-subtitle { margin: 0; color: #71909f; font-size: 8px; letter-spacing: .29em; }

    .core-stage {
      position: relative;
      height: clamp(300px, 39vw, 430px);
      display: grid;
      place-items: center;
      perspective: 900px;
      isolation: isolate;
    }

    .core-stage::before {
      position: absolute;
      z-index: -1;
      width: 86%;
      height: 55%;
      content: "";
      border-radius: 50%;
      background: radial-gradient(ellipse, rgba(40, 196, 237, .18), transparent 68%);
      filter: blur(23px);
      transform: translateY(18%);
    }

    .core-assembly {
      position: relative;
      width: min(310px, 67vw);
      aspect-ratio: 1;
      transform-style: preserve-3d;
      animation: float-core 6s ease-in-out infinite;
    }

    .core-ring {
      position: absolute;
      inset: 5%;
      border: 1px solid rgba(var(--accent-rgb), .49);
      border-radius: 50%;
      box-shadow: 0 0 16px rgba(var(--accent-rgb), .1), inset 0 0 17px rgba(var(--accent-rgb), .08);
      transform-style: preserve-3d;
    }

    .ring-one { transform: rotateX(71deg) rotateZ(-20deg); animation: orbit-one 13s linear infinite; }
    .ring-two { inset: 0; border-color: rgba(var(--blue-rgb), .38); transform: rotateY(71deg) rotateZ(28deg); animation: orbit-two 17s linear infinite; }
    .ring-three { inset: 13%; border-color: rgba(var(--violet-rgb), .42); transform: rotateX(18deg) rotateY(67deg); animation: orbit-three 11s linear infinite; }

    .ring-one::before, .ring-two::before, .ring-three::before {
      position: absolute;
      top: 10%;
      left: 14%;
      width: 7px;
      height: 7px;
      content: "";
      border-radius: 50%;
      background: var(--ink);
      box-shadow: 0 0 13px 4px rgba(var(--accent-rgb), .76);
    }

    .core-shell {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 57%;
      aspect-ratio: 1;
      overflow: hidden;
      border: 1px solid rgba(var(--accent-rgb), .86);
      border-radius: 50%;
      background:
        radial-gradient(circle at 37% 29%, rgba(238, 255, 255, .95) 0, rgba(var(--accent-rgb), .72) 6%, transparent 18%),
        radial-gradient(circle at 40% 35%, rgba(var(--accent-rgb), .78), rgba(var(--blue-rgb), .67) 31%, rgba(9, 34, 77, .88) 58%, rgba(4, 13, 35, .97) 75%);
      box-shadow:
        0 0 22px rgba(var(--accent-rgb), .76),
        0 0 65px rgba(var(--blue-rgb), .46),
        0 0 120px rgba(var(--blue-rgb), .2),
        inset -19px -23px 34px rgba(0, 2, 17, .77),
        inset 11px 8px 20px rgba(212, 255, 255, .36);
      transform: translate(-50%, -50%) translateZ(24px);
      animation: core-breathe 4s ease-in-out infinite;
    }

    .core-shell::before {
      position: absolute;
      inset: 12% 16% 48% 17%;
      content: "";
      border-radius: 50%;
      background: linear-gradient(150deg, rgba(255,255,255,.72), rgba(121,249,255,.12) 48%, transparent 72%);
      filter: blur(5px);
      transform: rotate(-28deg);
    }

    .core-shell::after {
      position: absolute;
      top: 25%;
      left: 28%;
      width: 36%;
      height: 36%;
      content: "";
      border: 1px solid rgba(var(--accent-rgb), .37);
      border-radius: 50%;
      box-shadow: inset 0 0 22px rgba(var(--accent-rgb), .44), 0 0 17px rgba(var(--accent-rgb), .31);
      opacity: .72;
    }

    .core-floor {
      position: absolute;
      right: 11%;
      bottom: 4%;
      left: 11%;
      height: 12%;
      border: 1px solid rgba(var(--accent-rgb), .44);
      border-radius: 50%;
      background: radial-gradient(ellipse, rgba(var(--accent-rgb), .28), transparent 68%);
      filter: blur(2px);
      transform: rotateX(69deg) translateZ(-27px);
    }

    .core-readout { margin-top: -8px; }
    .state-label { color: #84a8b8; font-size: 9px; letter-spacing: .22em; }
    .state-message {
      min-height: 22px;
      margin: 9px 0 0;
      color: var(--cyan);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .15em;
      text-shadow: 0 0 15px rgba(var(--accent-rgb), .32);
    }
    .heard-command { min-height: 16px; margin: 7px 0 0; color: #819aaa; font-size: 10px; }

    .listen-button {
      position: relative;
      min-width: 190px;
      min-height: 48px;
      margin-top: 17px;
      padding: 0 23px;
      overflow: hidden;
      border: 1px solid rgba(var(--accent-rgb), .62);
      border-radius: 3px;
      color: var(--ink);
      background: linear-gradient(100deg, rgba(var(--accent-rgb), .18), rgba(var(--blue-rgb), .2));
      box-shadow: 0 0 21px rgba(var(--accent-rgb), .1), inset 0 0 18px rgba(var(--accent-rgb), .06);
      cursor: pointer;
      font: inherit;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .2em;
      transition: background .2s, box-shadow .2s, transform .2s;
    }

    .listen-button::before {
      position: absolute;
      inset: 0;
      content: "";
      background: linear-gradient(110deg, transparent 25%, rgba(255,255,255,.16) 50%, transparent 72%);
      transform: translateX(-110%);
      transition: transform .5s;
    }

    .listen-button:hover::before { transform: translateX(110%); }
    .listen-button:hover { transform: translateY(-1px); box-shadow: 0 0 27px rgba(var(--accent-rgb), .24); }
    .listen-button:focus-visible, .wake-toggle:focus-visible, .command-input:focus-visible, .send-button:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
    .listen-button:disabled { cursor: wait; opacity: .72; }
    .listen-icon { margin-right: 10px; color: var(--cyan); font-size: 14px; vertical-align: -1px; }

    .wake-toggle {
      min-height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      margin-top: 10px;
      padding: 0 14px;
      border: 1px solid rgba(var(--accent-rgb), .3);
      color: var(--cyan);
      background: rgba(var(--accent-rgb), .06);
      cursor: pointer;
      font: inherit;
      font-size: 8px;
      font-weight: 700;
      letter-spacing: .14em;
      transition: background .2s, box-shadow .2s, border-color .2s;
    }

    .wake-toggle:hover:not(:disabled) { background: rgba(var(--accent-rgb), .13); }
    .wake-toggle[aria-pressed="true"] { border-color: rgba(var(--accent-rgb), .7); background: rgba(var(--accent-rgb), .12); box-shadow: 0 0 17px rgba(var(--accent-rgb), .12); }
    .wake-toggle:disabled { cursor: wait; opacity: .64; }
    .wake-indicator { width: 6px; height: 6px; border-radius: 50%; background: #668394; box-shadow: 0 0 0 transparent; }
    .wake-toggle[aria-pressed="true"] .wake-indicator { background: var(--cyan); box-shadow: 0 0 10px var(--cyan); animation: signal 1s ease-in-out infinite alternate; }
    .wake-hint { max-width: 350px; margin: 7px auto 0; color: var(--muted); font-size: 8px; line-height: 1.5; }

    .command-form {
      width: min(420px, 100%);
      display: flex;
      gap: 8px;
      margin: 18px auto 0;
      padding: 5px;
      border: 1px solid rgba(var(--accent-rgb), .17);
      background: rgba(5, 14, 25, .52);
    }

    .command-input {
      min-width: 0;
      flex: 1;
      padding: 8px 10px;
      border: 0;
      color: var(--ink);
      background: transparent;
      font: inherit;
      font-size: 10px;
      letter-spacing: .05em;
    }

    .command-input::placeholder { color: var(--muted); }
    .command-input:disabled, .send-button:disabled { cursor: not-allowed; opacity: .48; }
    .send-button { padding: 0 13px; border: 1px solid rgba(var(--accent-rgb), .27); color: var(--cyan); background: rgba(var(--accent-rgb), .1); cursor: pointer; font: inherit; font-size: 8px; letter-spacing: .14em; }

    .speech-settings {
      width: min(420px, 100%);
      margin: 14px auto 0;
      padding: 12px 13px;
      border: 1px solid rgba(var(--accent-rgb), .14);
      background: rgba(5, 14, 25, .38);
      text-align: left;
    }

    .speech-settings-heading { margin: 0 0 10px; color: var(--cyan); font-size: 8px; letter-spacing: .18em; }
    .voice-output-heading { margin-top: 15px; }
    .speech-setting { display: grid; grid-template-columns: 55px minmax(0, 1fr); align-items: center; gap: 10px; }
    .speech-setting + .speech-setting { margin-top: 9px; }
    .speech-setting label { color: var(--muted); font-size: 8px; letter-spacing: .1em; text-transform: uppercase; }
    .voice-select {
      width: 100%;
      min-width: 0;
      padding: 7px 9px;
      border: 1px solid rgba(var(--accent-rgb), .18);
      border-radius: 0;
      color: var(--ink);
      background: #081522;
      font: inherit;
      font-size: 9px;
    }

    .rate-controls { display: flex; align-items: center; gap: 9px; }
    .rate-slider { width: 100%; min-width: 0; accent-color: var(--cyan); cursor: pointer; }
    .rate-value { min-width: 38px; color: var(--cyan); font-size: 9px; text-align: right; }
    .speech-setting :focus-visible, .preview-button:focus-visible { outline: 2px solid #c2faff; outline-offset: 3px; }
    .preview-button {
      width: 100%;
      margin-top: 10px;
      padding: 7px 9px;
      border: 1px solid rgba(var(--accent-rgb), .22);
      color: var(--cyan);
      background: rgba(var(--accent-rgb), .08);
      cursor: pointer;
      font: inherit;
      font-size: 8px;
      letter-spacing: .14em;
    }
    .preview-button:hover { background: rgba(var(--accent-rgb), .16); }

    .side-code { margin: 16px 0 0; color: #668495; font-size: 8px; line-height: 1.7; letter-spacing: .08em; }

    .mini-orbit {
      width: 70px;
      height: 70px;
      position: relative;
      margin: 8px auto 18px;
      border: 1px solid rgba(var(--accent-rgb), .36);
      border-radius: 50%;
      box-shadow: inset 0 0 19px rgba(var(--accent-rgb), .12), 0 0 18px rgba(var(--accent-rgb), .09);
    }

    .mini-orbit::before, .mini-orbit::after { position: absolute; content: ""; border: 1px solid rgba(var(--violet-rgb), .42); border-radius: 50%; }
    .mini-orbit::before { inset: 13px -6px; transform: rotate(52deg); }
    .mini-orbit::after { inset: -5px 15px; transform: rotate(-34deg); border-color: rgba(var(--accent-rgb), .43); }
    .mini-core { position: absolute; inset: 23px; border-radius: 50%; background: radial-gradient(circle at 35% 32%, var(--ink), var(--cyan) 23%, var(--blue) 67%, #14285d); box-shadow: 0 0 14px rgba(var(--accent-rgb), .72); }

    .app-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 17px; }
    .app-chip { min-height: 30px; display: flex; align-items: center; gap: 7px; padding: 6px 7px; border: 1px solid rgba(125, 216, 245, .12); color: #9cb8c4; background: rgba(8, 22, 35, .52); font-size: 8px; letter-spacing: .04em; }
    .app-chip span { color: var(--cyan); font-size: 9px; }

    .bottom-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding-top: 17px;
      border-top: 1px solid rgba(125, 216, 245, .15);
      color: #668394;
      font-size: 8px;
      letter-spacing: .15em;
    }

    .bottom-left, .bottom-right { display: flex; align-items: center; gap: 10px; }
    .bottom-mark { color: #85afc0; }

    body.wake-enabled .core-ring { border-color: rgba(var(--accent-rgb), .74); box-shadow: 0 0 20px rgba(var(--accent-rgb), .18), inset 0 0 17px rgba(var(--accent-rgb), .1); }
    body[data-mode="listening"] .core-shell { animation-duration: 1.2s; box-shadow: 0 0 29px rgba(var(--accent-rgb), .9), 0 0 92px rgba(var(--blue-rgb), .66), 0 0 145px rgba(var(--blue-rgb), .32), inset -19px -23px 34px rgba(0, 2, 17, .77), inset 11px 8px 20px rgba(212, 255, 255, .36); }
    body[data-mode="listening"] .core-ring { border-color: rgba(var(--accent-rgb), .83); box-shadow: 0 0 24px rgba(var(--accent-rgb), .27), inset 0 0 17px rgba(var(--accent-rgb), .12); }
    body[data-mode="listening"] .signal-bars i { animation: signal .55s ease-in-out infinite alternate; }
    body[data-mode="listening"] .signal-bars i:nth-child(2n) { animation-delay: .18s; }
    body[data-mode="processing"] .core-shell { animation: core-breathe .5s ease-in-out infinite alternate; }
    body[data-mode="error"] .state-message { color: #ffb4bc; text-shadow: 0 0 13px rgba(255, 97, 122, .24); }
    body.speaking .core-shell { box-shadow: 0 0 29px rgba(var(--accent-rgb), .86), 0 0 90px rgba(var(--violet-rgb), .48), 0 0 135px rgba(var(--blue-rgb), .24), inset -19px -23px 34px rgba(0, 2, 17, .77), inset 11px 8px 20px rgba(212, 255, 255, .36); }

    @keyframes float-core { 0%, 100% { transform: translateY(0) rotateX(-4deg); } 50% { transform: translateY(-8px) rotateX(4deg); } }
    @keyframes orbit-one { to { transform: rotateX(71deg) rotateZ(340deg); } }
    @keyframes orbit-two { to { transform: rotateY(71deg) rotateZ(388deg); } }
    @keyframes orbit-three { to { transform: rotateX(18deg) rotateY(427deg); } }
    @keyframes core-breathe { 0%, 100% { filter: saturate(.92) brightness(.94); } 50% { filter: saturate(1.22) brightness(1.16); } }
    @keyframes signal { to { height: 4px; opacity: .44; } }

    /* Lunar's glass command deck */
    .interface {
      width: min(1500px, 100%);
      min-height: 100vh;
      padding: 24px clamp(16px, 4vw, 58px) 20px;
    }

    .topbar {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(190px, 1fr) auto minmax(170px, 1fr);
      gap: 20px;
      min-height: 78px;
      padding: 12px 16px;
      border: 1px solid rgba(204, 239, 255, .14);
      border-radius: 26px;
      background: linear-gradient(120deg, rgba(255,255,255,.105), rgba(255,255,255,.035) 38%, rgba(var(--accent-rgb), .065));
      box-shadow: 0 24px 70px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.16), inset 0 -1px 0 rgba(255,255,255,.035);
      backdrop-filter: blur(28px) saturate(170%);
      -webkit-backdrop-filter: blur(28px) saturate(170%);
    }

    .topbar::after {
      position: absolute;
      inset: 0 12% auto;
      height: 1px;
      content: "";
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.6), transparent);
      pointer-events: none;
    }

    .brand { gap: 12px; }
    .brand-mark {
      width: 42px;
      height: 42px;
      border-color: rgba(255,255,255,.25);
      background: radial-gradient(circle at 30% 25%, rgba(255,255,255,.3), rgba(var(--accent-rgb),.14) 38%, rgba(7,17,31,.4));
      box-shadow: 0 0 25px rgba(var(--accent-rgb),.2), inset 0 1px 0 rgba(255,255,255,.25);
      font-size: 15px;
    }
    .brand-name { font-size: 13px; letter-spacing: .3em; }
    .brand-sub { font-size: 8px; letter-spacing: .15em; }

    .page-nav {
      align-self: center;
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 5px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 18px;
      background: rgba(2,8,17,.26);
      box-shadow: inset 0 1px 8px rgba(0,0,0,.22);
    }
    .nav-tab {
      min-width: 96px;
      min-height: 40px;
      padding: 0 15px;
      border: 1px solid transparent;
      border-radius: 13px;
      color: #9eb5c8;
      background: transparent;
      cursor: pointer;
      font: inherit;
      font-size: 10px;
      font-weight: 650;
      letter-spacing: .08em;
      transition: color .2s, background .2s, border-color .2s, box-shadow .2s, transform .2s;
    }
    .nav-tab:hover { color: var(--ink); background: rgba(255,255,255,.055); }
    .nav-tab[aria-selected="true"] {
      color: #f2fdff;
      border-color: rgba(var(--accent-rgb),.27);
      background: linear-gradient(140deg, rgba(var(--accent-rgb),.18), rgba(var(--blue-rgb),.12));
      box-shadow: 0 6px 20px rgba(var(--accent-rgb),.1), inset 0 1px 0 rgba(255,255,255,.13);
    }
    .nav-tab:focus-visible, .theme-choice:focus-visible, .page-jump:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
    .link-status { justify-self: end; font-size: 8px; letter-spacing: .12em; }

    .page-stack { flex: 1; min-width: 0; padding: 30px 0 28px; }
    .page[hidden] { display: none !important; }
    .page.is-active { animation: page-arrive .38s ease both; }
    @keyframes page-arrive { from { opacity: 0; transform: translateY(8px) scale(.995); } to { opacity: 1; transform: translateY(0) scale(1); } }

    .page-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin: 2px 2px 23px;
    }
    .page-title { margin: 8px 0 5px; color: #f1fbff; font-size: clamp(25px,3vw,38px); font-weight: 350; letter-spacing: -.035em; }
    .page-copy { max-width: 580px; margin: 0; color: #92aabd; font-size: 12px; line-height: 1.7; letter-spacing: .01em; }
    .page-kicker { color: var(--cyan); font-size: 9px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }

    .glass-card {
      position: relative;
      min-width: 0;
      padding: 23px;
      overflow: hidden;
      border: 1px solid rgba(214,241,255,.16);
      border-radius: 25px;
      background: linear-gradient(145deg, rgba(255,255,255,.095), rgba(255,255,255,.032) 43%, rgba(var(--accent-rgb),.045)), rgba(5,14,27,.58);
      box-shadow: 0 25px 70px rgba(0,0,0,.26), inset 0 1px 0 rgba(255,255,255,.13), inset 0 -1px 0 rgba(255,255,255,.035);
      backdrop-filter: blur(24px) saturate(165%);
      -webkit-backdrop-filter: blur(24px) saturate(165%);
    }
    .glass-card::before {
      position: absolute;
      inset: 0 10% auto;
      height: 1px;
      content: "";
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.43), transparent);
      pointer-events: none;
    }
    .glass-card::after {
      position: absolute;
      top: -100px;
      right: -100px;
      width: 190px;
      height: 190px;
      content: "";
      border-radius: 50%;
      background: rgba(var(--accent-rgb),.08);
      filter: blur(52px);
      pointer-events: none;
    }
    .card-overline { margin: 0; color: var(--cyan); font-size: 8px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
    .card-title { margin: 9px 0 7px; color: #effaff; font-size: 15px; font-weight: 550; letter-spacing: .02em; }
    .card-description { margin: 0; color: #91aabd; font-size: 10px; line-height: 1.7; }

    .assistant-grid { display: grid; grid-template-columns: minmax(190px,.78fr) minmax(390px,1.5fr) minmax(190px,.78fr); align-items: center; gap: clamp(14px,2vw,26px); }
    .assistant-side { min-height: 265px; }
    .assistant-center { min-width: 0; padding: 12px 4px 4px; text-align: center; }
    .assistant-center .core-title { margin-top: 0; font-size: clamp(30px,4vw,46px); }
    .assistant-center .core-subtitle { font-size: 8px; letter-spacing: .24em; }
    .assistant-center .core-stage { height: clamp(260px,32vw,360px); }
    .assistant-center .core-assembly { width: min(310px,55vw); }
    .assistant-center .core-readout { max-width: 480px; margin: -3px auto 0; }
    .state-label { font-size: 9px; }
    .state-message { min-height: 18px; font-size: 10px; }
    .heard-command { max-width: 420px; margin-right: auto; margin-left: auto; font-size: 11px; line-height: 1.55; overflow-wrap: anywhere; }

    .status-line { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 13px 0; border-top: 1px solid rgba(255,255,255,.09); }
    .status-line:first-of-type { margin-top: 19px; }
    .status-name { color: #91aabd; font-size: 9px; letter-spacing: .08em; }
    .status-value { color: #e3f7ff; font-size: 9px; font-weight: 700; letter-spacing: .09em; }
    .status-value.live { color: #75f2d2; }
    .status-orb { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: #62f4d0; box-shadow: 0 0 12px #62f4d0; }
    .mini-command { display: flex; align-items: center; gap: 10px; margin-top: 17px; padding: 12px; border: 1px solid rgba(var(--accent-rgb),.16); border-radius: 15px; background: rgba(3,11,22,.32); color: #b9cddd; font-size: 10px; }
    .mini-command-icon { display: grid; place-items: center; width: 28px; height: 28px; flex: 0 0 28px; border: 1px solid rgba(var(--accent-rgb),.2); border-radius: 10px; color: var(--cyan); background: rgba(var(--accent-rgb),.08); }
    .assistant-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 9px; margin-top: 14px; }
    .assistant-center .listen-button { min-height: 49px; margin-top: 0; border-radius: 16px; }
    .assistant-center .wake-toggle { min-height: 43px; margin-top: 0; border-radius: 15px; }
    .assistant-center .wake-hint { max-width: 440px; margin-top: 10px; font-size: 9px; }
    .assistant-center .command-form { margin-top: 15px; padding: 6px; border: 1px solid rgba(220,243,255,.17); border-radius: 17px; background: rgba(3,10,20,.4); box-shadow: inset 0 1px 9px rgba(0,0,0,.24), 0 10px 30px rgba(0,0,0,.1); }
    .assistant-center .command-input { padding: 10px 12px; font-size: 11px; }
    .assistant-center .send-button { min-height: 37px; border-radius: 12px; }
    .page-jump { width: 100%; min-height: 39px; margin-top: 18px; border: 1px solid rgba(var(--accent-rgb),.22); border-radius: 13px; color: var(--cyan); background: rgba(var(--accent-rgb),.07); cursor: pointer; font: inherit; font-size: 9px; font-weight: 700; letter-spacing: .12em; transition: background .2s, transform .2s; }
    .page-jump:hover { transform: translateY(-2px); background: rgba(var(--accent-rgb),.13); }

    .settings-layout { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); align-items: start; gap: 20px; }
    .settings-card { min-height: 265px; }
    .settings-card .card-title { margin-bottom: 8px; }
    .theme-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; margin-top: 21px; }
    .theme-choice { display: flex; align-items: center; gap: 12px; min-height: 63px; padding: 10px 12px; border: 1px solid rgba(255,255,255,.105); border-radius: 16px; color: var(--ink); background: rgba(1,8,18,.3); cursor: pointer; text-align: left; transition: transform .2s, border-color .2s, background .2s, box-shadow .2s; }
    .theme-choice:hover { transform: translateY(-2px); border-color: rgba(var(--accent-rgb),.4); background: rgba(255,255,255,.06); }
    .theme-choice[aria-pressed="true"] { border-color: rgba(var(--accent-rgb),.54); background: linear-gradient(120deg,rgba(var(--accent-rgb),.12),rgba(255,255,255,.045)); box-shadow: 0 8px 26px rgba(var(--accent-rgb),.09),inset 0 1px 0 rgba(255,255,255,.12); }
    .theme-preview { width: 32px; height: 32px; flex: 0 0 32px; border: 1px solid rgba(255,255,255,.35); border-radius: 12px; box-shadow: inset 0 1px 3px rgba(255,255,255,.42),0 0 17px currentColor; }
    .theme-preview[data-tone="cyan"] { color: #68eaff; background: radial-gradient(circle at 32% 28%,#eaffff,#67eaff 38%,#2861bb); }
    .theme-preview[data-tone="amethyst"] { color: #d2a5ff; background: radial-gradient(circle at 32% 28%,#fff1ff,#ce94ff 38%,#603caa); }
    .theme-preview[data-tone="emerald"] { color: #6cf0bd; background: radial-gradient(circle at 32% 28%,#ebfff8,#6cf0bd 38%,#197766); }
    .theme-preview[data-tone="amber"] { color: #ffd17c; background: radial-gradient(circle at 32% 28%,#fff9e8,#ffd17c 38%,#ac553f); }
    .theme-name { display: block; font-size: 10px; font-weight: 650; letter-spacing: .035em; }
    .theme-note { display: block; margin-top: 4px; color: var(--muted); font-size: 8px; }
    #theme-select[hidden] { display: none; }
    .settings-voice .speech-settings { width: 100%; margin: 20px 0 0; padding: 0; border: 0; background: transparent; }
    .settings-voice .speech-settings-heading { display: none; }
    .settings-voice .speech-setting { grid-template-columns: 70px minmax(0,1fr); gap: 13px; }
    .settings-voice .speech-setting + .speech-setting { margin-top: 15px; }
    .settings-voice .speech-setting label { font-size: 9px; }
    .settings-voice .voice-select { min-height: 43px; padding: 0 13px; border-color: rgba(223,241,255,.16); border-radius: 13px; background: rgba(3,11,23,.55); font-size: 10px; }
    .settings-voice .rate-controls { min-height: 43px; padding: 0 12px; border: 1px solid rgba(223,241,255,.13); border-radius: 13px; background: rgba(3,11,23,.38); }
    .settings-voice .preview-button { min-height: 41px; margin-top: 18px; border-radius: 13px; font-size: 9px; }
    .settings-footnote { display: flex; align-items: center; gap: 10px; margin: 19px 0 0; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.09); color: #96adbf; font-size: 9px; line-height: 1.6; }

    .guide-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
    .guide-card { min-height: 216px; transition: transform .22s, border-color .22s, box-shadow .22s; }
    .guide-card:hover { transform: translateY(-4px); border-color: rgba(var(--accent-rgb),.3); box-shadow: 0 31px 74px rgba(0,0,0,.3),0 0 27px rgba(var(--accent-rgb),.075),inset 0 1px 0 rgba(255,255,255,.15); }
    .guide-icon { display: grid; place-items: center; width: 39px; height: 39px; margin-bottom: 18px; border: 1px solid rgba(var(--accent-rgb),.22); border-radius: 14px; color: var(--cyan); background: linear-gradient(145deg,rgba(var(--accent-rgb),.17),rgba(255,255,255,.035)); box-shadow: inset 0 1px 0 rgba(255,255,255,.12),0 8px 22px rgba(var(--accent-rgb),.07); font-size: 15px; }
    .guide-examples { display: grid; gap: 8px; margin-top: 15px; }
    .guide-examples code { display: block; padding: 9px 10px; border: 1px solid rgba(255,255,255,.08); border-radius: 11px; color: #b8d0df; background: rgba(1,8,18,.32); font: 9px/1.5 "Cascadia Code", Consolas, monospace; }
    .guide-footnote { margin-top: 20px; padding: 17px 19px; border: 1px solid rgba(255,255,255,.11); border-radius: 17px; color: #a1b7c8; background: rgba(255,255,255,.035); font-size: 10px; line-height: 1.7; }

    .bottom-bar { padding-top: 14px; border-color: rgba(255,255,255,.1); font-size: 8px; }

    @media (max-width: 1080px) {
      .assistant-grid { grid-template-columns: minmax(0,1fr) minmax(0,1.25fr); }
      .assistant-center { grid-column: 1 / -1; grid-row: 1; }
      .assistant-side { min-height: 230px; }
      .guide-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    }

    @media (max-width: 720px) {
      .interface { padding: 13px 13px 15px; }
      .topbar { grid-template-columns: 1fr auto; gap: 12px; min-height: 0; padding: 12px; border-radius: 21px; }
      .brand-mark { width: 37px; height: 37px; }
      .brand-name { font-size: 11px; }
      .brand-sub { font-size: 7px; }
      .link-status { grid-column: 2; grid-row: 1; gap: 6px; max-width: 110px; font-size: 7px; line-height: 1.5; text-align: right; }
      .page-nav { grid-column: 1 / -1; width: 100%; }
      .nav-tab { min-width: 0; min-height: 38px; flex: 1; padding: 0 7px; font-size: 9px; }
      .page-stack { padding: 24px 0 20px; }
      .page-heading { align-items: start; margin-bottom: 17px; }
      .page-title { font-size: 29px; }
      .page-copy { font-size: 11px; }
      .glass-card { padding: 18px; border-radius: 21px; }
      .assistant-grid { display: flex; flex-direction: column; align-items: stretch; gap: 13px; }
      .assistant-center { order: -1; padding: 12px 0 18px; }
      .assistant-center .core-stage { height: min(76vw,320px); }
      .assistant-center .core-assembly { width: min(285px,68vw); }
      .assistant-side { min-height: 0; }
      .assistant-actions { gap: 7px; }
      .assistant-center .listen-button { min-width: 150px; padding: 0 14px; font-size: 8px; }
      .assistant-center .wake-toggle { padding: 0 10px; font-size: 7px; }
      .settings-layout, .guide-grid { grid-template-columns: 1fr; }
      .settings-card { min-height: 0; }
      .theme-grid { gap: 8px; }
      .theme-choice { min-height: 58px; padding: 8px; }
      .theme-preview { width: 27px; height: 27px; flex-basis: 27px; border-radius: 10px; }
      .guide-card { min-height: 0; }
      .bottom-bar { align-items: flex-start; font-size: 7px; }
      .bottom-right { gap: 6px; }
    }

    @media (max-width: 1020px) {
      .content { grid-template-columns: minmax(145px, .72fr) minmax(350px, 1.5fr); gap: 25px; }
      .side-panel.right-panel { display: none; }
    }

    @media (max-width: 700px) {
      .interface { padding: 17px 16px 15px; }
      .topbar { min-height: 48px; }
      .link-status { font-size: 7px; letter-spacing: .1em; }
      .content { display: flex; flex-direction: column; gap: 14px; padding: 24px 0 18px; }
      .core-section { order: 0; width: 100%; }
      .side-panel.left-panel { order: 1; width: 100%; padding: 13px 14px; }
      .side-panel.left-panel .panel-heading { margin-bottom: 12px; }
      .side-panel.left-panel .metric { display: inline-block; width: 49%; padding: 10px 0 4px; }
      .side-panel.left-panel .metric:nth-of-type(2) { border-top: 0; }
      .side-panel.left-panel .metric:last-child { display: none; }
      .core-stage { height: min(75vw, 340px); }
      .core-assembly { width: min(280px, 73vw); }
      .core-title { letter-spacing: .2em; }
      .core-subtitle { font-size: 7px; letter-spacing: .17em; }
      .bottom-bar { font-size: 7px; letter-spacing: .08em; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }
    }

    /* Vintage paper, ink and brass. */
    :root, body[data-theme="cyan"] {
      color-scheme: light;
      --ink: #30261c; --muted: #6c5d49; --cyan: #805c31; --blue: #64745f; --violet: #8a7056;
      --glass: #efe5d2; --line: #9c8052;
      --accent-rgb: 128,92,49; --blue-rgb: 100,116,95; --violet-rgb: 138,112,86;
      --bg-glow-one: rgba(255,247,226,.32); --bg-glow-two: rgba(117,83,48,.04); --bg-glow-three: rgba(117,83,48,.03);
      --ambient-glow: rgba(255,246,221,.12); --grid-line: rgba(113,82,48,.07);
    }
    body[data-theme="amethyst"] { --cyan: #745b71; --accent-rgb: 116,91,113; --blue-rgb: 112,105,121; --violet-rgb: 145,111,126; }
    body[data-theme="emerald"] { --cyan: #526a50; --accent-rgb: 82,106,80; --blue-rgb: 103,116,91; --violet-rgb: 121,116,87; }
    body[data-theme="amber"] { --cyan: #93642e; --accent-rgb: 147,100,46; --blue-rgb: 125,97,61; --violet-rgb: 151,109,66; }

    body {
      color: var(--ink);
      background: radial-gradient(ellipse at 50% 25%, rgba(255,250,233,.65), transparent 70%), #d9ccb2;
      font-family: "Palatino Linotype", Palatino, Georgia, serif;
      letter-spacing: 0;
    }
    body::before, .floor-grid, .ambient-light { display: none; }
    .interface { position: relative; z-index: 1; width: min(1340px,100%); padding-top: 23px; padding-bottom: 18px; }
    .topbar {
      min-height: 68px; padding: 10px 15px; border: 3px double #9c8052; border-radius: 0;
      color: #eee2ca; background: #34281d;
      box-shadow: 3px 3px 0 rgba(61,44,27,.25);
      backdrop-filter: none; -webkit-backdrop-filter: none;
    }
    .topbar::after { display: none; }
    .brand-mark { width: 40px; height: 40px; border: 1px solid #b59a68; border-radius: 0; color: #d7b779; background: #403021; box-shadow: inset 0 0 0 2px rgba(215,183,121,.14); }
    .brand-name { color: #f0e5d0; font-family: Georgia, serif; font-size: 14px; letter-spacing: .16em; }
    .brand-sub { color: #c4b398; font-size: 10px; letter-spacing: .06em; }
    .link-status { color: #dac9aa; font-family: Georgia, serif; font-size: 11px; letter-spacing: .04em; }
    .link-dot, .small-dot { box-shadow: none; }

    .page-nav { gap: 0; padding: 0; border: 1px solid #786345; border-radius: 0; background: transparent; box-shadow: none; }
    .nav-tab { min-height: 38px; border: 0; border-right: 1px solid #786345; border-radius: 0; color: #d8c9ae; font-family: Georgia, serif; font-size: 12px; font-weight: 500; letter-spacing: .025em; }
    .nav-tab:last-child { border-right: 0; }
    .nav-tab:hover { color: #fff2d8; background: rgba(255,246,222,.08); }
    .nav-tab[aria-selected="true"] { color: #33271d; border-color: #d1bb90; background: #d1bb90; box-shadow: inset 0 0 0 1px #f1e0ba; }
    .nav-tab:focus-visible, .theme-choice:focus-visible, .page-jump:focus-visible { outline: 2px solid #b08b4f; outline-offset: 2px; }

    .page-stack { padding: 32px 0 28px; }
    .page-heading { margin-bottom: 21px; }
    .page-title { margin: 6px 0 5px; color: #35291e; font-family: Georgia, "Times New Roman", serif; font-size: clamp(30px,3.1vw,38px); font-weight: 600; letter-spacing: -.025em; }
    .page-kicker { color: #765632; font-family: Georgia, serif; font-size: 12px; font-style: italic; font-weight: 500; letter-spacing: .025em; text-transform: none; }
    .page-copy { color: #655743; font-size: 14px; line-height: 1.55; letter-spacing: 0; }

    .glass-card {
      padding: 22px; border: 1px solid #a18a65; border-radius: 0;
      color: #34291f;
      background: linear-gradient(135deg,rgba(255,255,255,.35),transparent 50%), #efe5d2;
      box-shadow: 3px 3px 0 rgba(73,53,31,.2), inset 0 0 0 3px rgba(157,127,79,.08);
      backdrop-filter: none; -webkit-backdrop-filter: none;
    }
    .glass-card::before, .glass-card::after { display: none; }
    .card-overline { color: #755633; font-family: Georgia, serif; font-size: 12px; font-style: italic; font-weight: 600; letter-spacing: .025em; text-transform: none; }
    .card-title { margin: 9px 0 7px; color: #382b1e; font-family: Georgia, "Times New Roman", serif; font-size: 18px; font-weight: 600; letter-spacing: 0; }
    .card-description { color: #6a5b47; font-size: 13px; line-height: 1.55; }

    .assistant-grid { gap: clamp(14px,2vw,23px); }
    .assistant-side { min-height: 270px; }
    .assistant-center {
      min-width: 0; padding: 17px 19px 19px; border: 3px double #9c8052;
      background: #efe5d2; box-shadow: 3px 3px 0 rgba(73,53,31,.2);
    }
    .assistant-center .core-title { color: #3a2b1d; font-family: Georgia, serif; font-size: clamp(30px,3.3vw,40px); font-weight: 600; letter-spacing: .16em; }
    .assistant-center .core-subtitle { color: #776347; font-family: Georgia, serif; font-size: 11px; font-style: italic; letter-spacing: .035em; }
    .assistant-center .core-stage { height: clamp(230px,28vw,300px); }
    .assistant-center .core-assembly { width: min(290px,53vw); animation-duration: 9s; }
    .core-stage::before { display: none; }
    .core-ring { border-color: rgba(var(--accent-rgb),.58); border-style: double; box-shadow: inset 0 0 12px rgba(var(--accent-rgb),.08); opacity: .72; }
    .ring-one { animation-duration: 32s; }
    .ring-two { border-color: rgba(var(--blue-rgb),.5); animation-duration: 40s; }
    .ring-three { border-color: rgba(var(--violet-rgb),.5); animation-duration: 36s; }
    .ring-one::before, .ring-two::before, .ring-three::before { width: 6px; height: 6px; background: #ead9b5; box-shadow: 0 0 0 1px #755832; }
    .core-shell {
      border: 2px solid #6d4d29;
      background: radial-gradient(circle at 35% 28%,#fff1ce 0,#d9bd7e 9%,transparent 23%), radial-gradient(circle at 40% 35%,#b28a4c 0,#82613a 38%,#493620 70%,#2e2318 88%);
      box-shadow: 0 3px 10px rgba(49,35,20,.35), inset -19px -22px 32px rgba(22,15,9,.7), inset 10px 8px 19px rgba(255,239,194,.34);
      animation-duration: 7s;
    }
    .core-shell::before { background: linear-gradient(150deg,rgba(255,246,219,.5),rgba(236,208,147,.11) 48%,transparent 72%); filter: blur(3px); }
    .core-shell::after { border-color: rgba(235,207,150,.48); box-shadow: inset 0 0 14px rgba(235,207,150,.15); }
    .core-floor { border-color: rgba(var(--accent-rgb),.5); background: radial-gradient(ellipse,rgba(var(--accent-rgb),.15),transparent 70%); filter: blur(1px); }
    body.wake-enabled .core-ring, body[data-mode="listening"] .core-ring { border-color: rgba(var(--accent-rgb),.75); box-shadow: inset 0 0 12px rgba(var(--accent-rgb),.12); }
    body[data-mode="processing"] .core-shell { animation-duration: 1.8s; }
    body[data-mode="listening"] .core-shell, body.speaking .core-shell { box-shadow: 0 3px 13px rgba(49,35,20,.4), inset -19px -22px 32px rgba(22,15,9,.7), inset 10px 8px 19px rgba(255,239,194,.34); }
    body[data-mode="error"] .state-message { color: #8b4435; text-shadow: none; }
    .state-label { color: #78664e; font-size: 12px; letter-spacing: .035em; }
    .state-message { min-height: 22px; margin-top: 7px; color: #503c26; font-size: 14px; font-weight: 600; letter-spacing: 0; text-shadow: none; }
    .heard-command { color: #77684f; font-size: 12px; }

    .status-line { padding: 13px 0; border-top-color: rgba(111,85,52,.23); }
    .status-line:first-of-type { margin-top: 17px; }
    .status-name { color: #705e45; font-size: 12px; letter-spacing: 0; }
    .status-value { color: #3e3021; font-size: 11px; font-weight: 600; letter-spacing: .02em; }
    .status-value.live { color: #516a4e; }
    .status-orb { background: #667b54; box-shadow: none; }
    .mini-command { gap: 11px; margin-top: 15px; padding: 11px 12px; border: 1px solid #c1ad89; border-radius: 0; background: rgba(255,249,235,.55); color: #55452f; font-size: 12px; }
    .mini-command-icon { border-color: #c4ad7f; border-radius: 0; color: #765633; background: #e6d8bd; }
    .page-jump { min-height: 41px; border: 1px solid #9b7a4b; border-radius: 0; color: #4a3723; background: #e3d2b3; font-family: Georgia, serif; font-size: 12px; font-weight: 600; letter-spacing: .015em; }
    .page-jump:hover { transform: none; background: #d9c39b; }

    .listen-button { border: 1px solid #604321; border-radius: 0; color: #f2e6cc; background: #59432a; box-shadow: 2px 2px 0 #2f2419; font-family: Georgia, serif; font-size: 13px; font-weight: 600; letter-spacing: .04em; }
    .listen-button::before { display: none; }
    .listen-button:hover { transform: none; background: #684e30; box-shadow: 2px 2px 0 #2f2419; }
    .listen-icon { color: #ddc18c; }
    .wake-toggle { border: 1px solid #9b7a4b; border-radius: 0; color: #4a3723; background: #e4d5bb; font-family: Georgia, serif; font-size: 12px; font-weight: 600; letter-spacing: .015em; }
    .wake-toggle:hover:not(:disabled) { background: #d9c39b; }
    .wake-toggle[aria-pressed="true"] { border-color: #5e4324; background: #c7a36b; box-shadow: inset 0 0 0 1px #ead4a9; }
    .wake-indicator, .wake-toggle[aria-pressed="true"] .wake-indicator { box-shadow: none; }
    .wake-toggle[aria-pressed="true"] .wake-indicator { background: #554126; }
    .wake-hint { max-width: 450px; margin-top: 12px; color: #76664d; font-size: 11px; }
    .assistant-center .command-form { border: 1px solid #9c8052; border-radius: 0; background: #fbf5e9; box-shadow: inset 1px 1px 2px rgba(89,67,42,.13); }
    .assistant-center .command-input { padding: 11px 12px; color: #35291d; font-family: "Courier New", monospace; font-size: 13px; }
    .assistant-center .command-input::placeholder { color: #8a7a61; }
    .assistant-center .send-button { min-height: 39px; border: 1px solid #9b7a4b; border-radius: 0; color: #473520; background: #e3d2b3; font-family: Georgia, serif; font-size: 12px; letter-spacing: .02em; }
    .assistant-center .send-button:hover { background: #d5c09a; }

    .theme-grid { gap: 10px; margin-top: 19px; }
    .theme-choice { min-height: 64px; border: 1px solid #b39a72; border-radius: 0; color: #3a2d1f; background: #f4ead7; box-shadow: 1px 1px 0 rgba(78,58,33,.16); }
    .theme-choice:hover { transform: none; border-color: #775a32; background: #eadcc1; }
    .theme-choice[aria-pressed="true"] { border-color: #76572f; background: #e4d3b1; box-shadow: inset 0 0 0 2px rgba(118,87,47,.15); }
    .theme-preview { border: 1px solid #816744; border-radius: 0; box-shadow: inset 1px 1px rgba(255,255,255,.35); }
    .theme-preview[data-tone="cyan"] { background: #8a8064; }
    .theme-preview[data-tone="amethyst"] { background: #796879; }
    .theme-preview[data-tone="emerald"] { background: #657657; }
    .theme-preview[data-tone="amber"] { background: #a1763f; }
    .theme-name { color: #3a2d1f; font-family: Georgia, serif; font-size: 13px; font-weight: 600; letter-spacing: 0; }
    .theme-note { color: #75664e; font-size: 11px; }
    .settings-voice .speech-setting label { color: #67563f; font-size: 12px; letter-spacing: 0; text-transform: none; }
    .settings-voice .voice-select, .settings-voice .rate-controls { min-height: 43px; border: 1px solid #b09a73; border-radius: 0; color: #33271c; background: #faf4e8; font-family: "Palatino Linotype", Georgia, serif; font-size: 12px; }
    .settings-voice .voice-select { padding: 0 11px; }
    .settings-voice .rate-controls { padding: 0 11px; }
    .rate-slider { accent-color: #80603b; }
    .rate-value { color: #614728; }
    .settings-voice .preview-button { min-height: 42px; border: 1px solid #9b7a4b; border-radius: 0; color: #46341f; background: #e4d5bb; font-family: Georgia, serif; font-size: 12px; letter-spacing: .02em; }
    .settings-voice .preview-button:hover { background: #d9c39b; }
    .settings-footnote { border-top-color: rgba(111,85,52,.22); color: #75664e; font-size: 11px; }

    .guide-grid { gap: 14px; }
    .guide-card { min-height: 218px; }
    .guide-card:hover { transform: none; border-color: #8c7047; box-shadow: 3px 3px 0 rgba(73,53,31,.2), inset 0 0 0 3px rgba(157,127,79,.08); }
    .guide-icon { border: 1px solid #a78a5c; border-radius: 0; color: #71512c; background: #e1d2b5; box-shadow: inset 1px 1px rgba(255,255,255,.45); }
    .guide-examples code { border-color: #c1ad89; border-radius: 0; color: #423421; background: #faf3e5; font: 12px/1.5 "Courier New", Consolas, monospace; }
    .guide-footnote { border: 1px solid #a18a65; border-radius: 0; color: #66563f; background: #ece0c9; font-size: 12px; }
    .bottom-bar { padding-top: 13px; border-color: rgba(111,85,52,.3); color: #716047; font-size: 10px; letter-spacing: .035em; }
    .bottom-mark { color: #805c31; }

    .interface button, .interface input, .interface select,
    .interface .topbar, .interface .page-nav, .interface .glass-card,
    .interface .brand-mark, .interface .mini-command, .interface .command-form,
    .interface .theme-preview, .interface .guide-icon, .interface .guide-examples code,
    .interface .guide-footnote, .interface .rate-controls {
      border-radius: 0 !important;
    }
    .interface button { transition: color .14s, background-color .14s, border-color .14s, box-shadow .14s; }
    .interface button:disabled { filter: grayscale(.3); }
    .interface :focus-visible { outline-color: #835e31; }
    .status-orb, .wake-indicator, .link-dot, .small-dot { box-shadow: none; }

    @media (max-width: 720px) {
      .interface { padding: 13px 13px 15px; }
      .topbar { gap: 10px; }
      .brand-mark { width: 36px; height: 36px; }
      .brand-name { font-size: 11px; }
      .brand-sub { font-size: 9px; }
      .link-status { max-width: 100px; font-size: 9px; }
      .nav-tab { padding: 0 7px; font-size: 10px; }
      .page-stack { padding: 25px 0 20px; }
      .page-title { font-size: 29px; }
      .page-copy { font-size: 13px; }
      .glass-card { padding: 17px; }
      .assistant-center { padding: 12px 14px 17px; }
      .assistant-center .core-stage { height: min(72vw,290px); }
      .assistant-center .core-assembly { width: min(265px,66vw); }
      .assistant-center .listen-button { min-width: 140px; font-size: 12px; }
      .assistant-center .wake-toggle { font-size: 11px; }
      .settings-layout, .guide-grid { grid-template-columns: 1fr; }
      .settings-card, .guide-card { min-height: 0; }
      .theme-choice { min-height: 58px; padding: 8px; }
      .theme-preview { width: 27px; height: 27px; flex-basis: 27px; }
      .theme-name { font-size: 12px; }
      .theme-note { font-size: 10px; }
      .bottom-bar { font-size: 9px; }
    }  </style>
</head>
<body data-mode="ready" data-theme="cyan">
  <div class="ambient-light" aria-hidden="true"></div>
  <div class="floor-grid" aria-hidden="true"></div>

  <div class="interface">
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">L</div>
        <div>
          <div class="brand-name">LUNAR</div>
          <div class="brand-sub">Voice assistant</div>
        </div>
      </div>
      <nav class="page-nav" role="tablist" aria-label="Lunar pages">
        <button class="nav-tab" id="tab-assistant" type="button" role="tab" aria-selected="true" aria-controls="page-assistant" data-page-target="assistant">Assistant</button>
        <button class="nav-tab" id="tab-settings" type="button" role="tab" aria-selected="false" aria-controls="page-settings" data-page-target="settings">Settings</button>
        <button class="nav-tab" id="tab-guide" type="button" role="tab" aria-selected="false" aria-controls="page-guide" data-page-target="guide">Command guide</button>
      </nav>
      <div class="link-status"><span class="link-dot" id="connection-dot"></span><span id="connection-label">Connected</span></div>
    </header>

    <main class="page-stack" id="page-container">
      <section class="page is-active" id="page-assistant" role="tabpanel" tabindex="0" aria-labelledby="tab-assistant" data-page-panel="assistant">
        <header class="page-heading">
          <div>
            <div class="page-kicker">Ready when you are</div>
            <h1 class="page-title">Assistant</h1>
            <p class="page-copy">Speak or type a command. For hands-free use, turn it on and start with Lunar.</p>
          </div>
        </header>

        <div class="assistant-grid">
          <aside class="glass-card assistant-side">
            <p class="card-overline">Status</p>
            <h2 class="card-title">Voice controls</h2>
            <p class="card-description">Your assistant is ready for a spoken or typed command.</p>
            <div class="status-line">
              <span class="status-name">Lunar system</span>
              <span class="status-value live"><span class="status-orb"></span>Online</span>
            </div>
            <div class="status-line">
              <span class="status-name">Listening mode</span>
              <strong class="status-value" id="voice-value">Standby</strong>
            </div>
            <div class="mini-command"><span class="mini-command-icon" aria-hidden="true">&#9673;</span><span>Wake phrase: <strong>Lunar</strong></span></div>
            <button class="page-jump" type="button" data-page-jump="guide">View command guide</button>
          </aside>

          <section class="assistant-center" aria-label="Lunar voice controls">
            <p class="page-kicker">Lunar is ready</p>
            <h2 class="core-title">LUNAR</h2>
            <p class="core-subtitle">Voice assistant</p>

            <div class="core-stage" aria-hidden="true">
              <div class="core-assembly">
                <div class="core-ring ring-one"></div>
                <div class="core-ring ring-two"></div>
                <div class="core-ring ring-three"></div>
                <div class="core-shell"></div>
                <div class="core-floor"></div>
              </div>
            </div>

            <div class="core-readout" aria-live="polite">
              <div class="state-label" id="state-label">Ready</div>
              <p class="state-message" id="state-message">Ready for a command</p>
              <p class="heard-command" id="heard-command">Say a command to begin.</p>
            </div>

            <div class="assistant-actions">
              <button class="listen-button" id="listen-button" type="button">
                <span class="listen-icon" aria-hidden="true">&#9678;</span><span id="listen-label">Listen</span>
              </button>
              <button class="wake-toggle" id="wake-toggle" type="button" aria-pressed="false">
                <span class="wake-indicator" aria-hidden="true"></span><span id="wake-label">Enable hands-free</span>
              </button>
            </div>
            <p class="wake-hint">Hands-free mode listens for Lunar only. Say Lunar, then your command.</p>

            <form class="command-form" id="command-form" autocomplete="off">
              <input class="command-input" id="command-input" type="text" maxlength="120" aria-label="Type a command" placeholder="Try: open Chrome, latest news, homework">
              <button class="send-button" type="submit">Send</button>
            </form>
          </section>

          <aside class="glass-card assistant-side">
            <p class="card-overline">Quick start</p>
            <h2 class="card-title">Everyday commands</h2>
            <p class="card-description">Open apps, search the web, check the weather, or visit a website by speaking naturally.</p>
            <div class="mini-command"><span class="mini-command-icon" aria-hidden="true">&#9672;</span><span>Say <strong>Lunar, latest news</strong></span></div>
            <div class="mini-command"><span class="mini-command-icon" aria-hidden="true">&#9729;</span><span>Say <strong>Lunar, weather in Delhi</strong></span></div>
            <button class="page-jump" type="button" data-page-jump="settings">Open settings</button>
          </aside>
        </div>
      </section>

      <section class="page" id="page-settings" role="tabpanel" tabindex="0" aria-labelledby="tab-settings" data-page-panel="settings" hidden>
        <header class="page-heading">
          <div>
            <div class="page-kicker">Personalize Lunar</div>
            <h1 class="page-title">Settings</h1>
            <p class="page-copy">Choose Lunar's colors and tune how its spoken replies sound. Your choices are saved on this device.</p>
          </div>
        </header>

        <div class="settings-layout">
          <section class="glass-card settings-card" aria-labelledby="theme-heading">
            <p class="card-overline">Interface appearance</p>
            <h2 class="card-title" id="theme-heading">Color theme</h2>
            <p class="card-description">Choose the accent color used across Lunar.</p>
            <select id="theme-select" aria-label="Lunar color theme" hidden>
              <option value="cyan">Lunar Cyan</option>
              <option value="amethyst">Amethyst</option>
              <option value="emerald">Emerald</option>
              <option value="amber">Amber</option>
            </select>
            <div class="theme-grid" role="group" aria-label="Color theme choices">
              <button class="theme-choice" type="button" data-theme-choice="cyan" aria-pressed="false"><span class="theme-preview" data-tone="cyan" aria-hidden="true"></span><span><span class="theme-name">Blue gray</span><span class="theme-note">A cool, quiet accent</span></span></button>
              <button class="theme-choice" type="button" data-theme-choice="amethyst" aria-pressed="false"><span class="theme-preview" data-tone="amethyst" aria-hidden="true"></span><span><span class="theme-name">Violet</span><span class="theme-note">A muted purple accent</span></span></button>
              <button class="theme-choice" type="button" data-theme-choice="emerald" aria-pressed="false"><span class="theme-preview" data-tone="emerald" aria-hidden="true"></span><span><span class="theme-name">Green</span><span class="theme-note">A muted green accent</span></span></button>
              <button class="theme-choice" type="button" data-theme-choice="amber" aria-pressed="false"><span class="theme-preview" data-tone="amber" aria-hidden="true"></span><span><span class="theme-name">Amber</span><span class="theme-note">A warm, soft accent</span></span></button>
            </div>
          </section>

          <section class="glass-card settings-card settings-voice" aria-labelledby="voice-heading">
            <p class="card-overline">Voice output</p>
            <h2 class="card-title" id="voice-heading">Spoken responses</h2>
            <p class="card-description">Select an installed voice and set a comfortable speaking speed.</p>
            <section class="speech-settings" aria-label="Lunar speech settings">
              <div class="speech-setting">
                <label for="voice-select">Voice</label>
                <select class="voice-select" id="voice-select" aria-label="Lunar spoken voice">
                  <option value="">Automatic - English</option>
                </select>
              </div>
              <div class="speech-setting">
                <label for="voice-rate">Speed</label>
                <div class="rate-controls">
                  <input class="rate-slider" id="voice-rate" type="range" min="0.75" max="1.25" step="0.05" value="0.95" aria-label="Lunar speaking speed">
                  <output class="rate-value" id="rate-value" for="voice-rate">0.95x</output>
                </div>
              </div>
              <button class="preview-button" id="voice-preview" type="button">Play voice preview</button>
            </section>
            <p class="settings-footnote"><span class="status-orb" aria-hidden="true"></span>Voice and speed preferences are stored locally in this browser.</p>
          </section>
        </div>
      </section>

      <section class="page" id="page-guide" role="tabpanel" tabindex="0" aria-labelledby="tab-guide" data-page-panel="guide" hidden>
        <header class="page-heading">
          <div>
            <div class="page-kicker">Things you can ask</div>
            <h1 class="page-title">Command guide</h1>
            <p class="page-copy">Use the listen button for one command, or enable hands-free and begin each command with Lunar.</p>
          </div>
        </header>

        <div class="guide-grid">
          <article class="glass-card guide-card">
            <span class="guide-icon" aria-hidden="true">&#9635;</span>
            <p class="card-overline">Apps</p>
            <h2 class="card-title">Launch an app</h2>
            <p class="card-description">Say the app name directly or ask Lunar to open it.</p>
            <div class="guide-examples"><code>open Chrome</code><code>open Claude</code><code>open calculator</code></div>
          </article>
          <article class="glass-card guide-card">
            <span class="guide-icon" aria-hidden="true">&#9678;</span>
            <p class="card-overline">Web</p>
            <h2 class="card-title">Search or visit</h2>
            <p class="card-description">Search in Chrome or say a website address.</p>
            <div class="guide-examples"><code>search for space news</code><code>instagram.com</code><code>open youtube.com</code></div>
          </article>
          <article class="glass-card guide-card">
            <span class="guide-icon" aria-hidden="true">&#9728;</span>
            <p class="card-overline">News and weather</p>
            <h2 class="card-title">News and weather</h2>
            <p class="card-description">Open current information in Chrome. Add a city for a specific forecast.</p>
            <div class="guide-examples"><code>latest news</code><code>today's weather</code><code>weather in Delhi</code></div>
          </article>
          <article class="glass-card guide-card">
            <span class="guide-icon" aria-hidden="true">&#9733;</span>
            <p class="card-overline">School</p>
            <h2 class="card-title">Homework</h2>
            <p class="card-description">Go straight to your Schoolpad homework page.</p>
            <div class="guide-examples"><code>homework</code></div>
          </article>
          <article class="glass-card guide-card">
            <span class="guide-icon" aria-hidden="true">&#9993;</span>
            <p class="card-overline">Messages</p>
            <h2 class="card-title">Read WhatsApp</h2>
            <p class="card-description">Keep WhatsApp Web open on the chat you want Lunar to read.</p>
            <div class="guide-examples"><code>read WhatsApp messages</code></div>
          </article>
          <article class="glass-card guide-card">
            <span class="guide-icon" aria-hidden="true">&#10022;</span>
            <p class="card-overline">Conversation</p>
            <h2 class="card-title">Ask Lunar</h2>
            <p class="card-description">Lunar can respond to simple greetings and status questions.</p>
            <div class="guide-examples"><code>hello</code><code>how are you</code></div>
          </article>
        </div>
        <p class="guide-footnote">Hands-free tip: turn it on from the Assistant page, then say Lunar followed by a command, for example: Lunar, open Chrome.</p>
      </section>
    </main>

    <footer class="bottom-bar">
      <div class="bottom-left"><span class="bottom-mark">&#9672;</span><span>Lunar assistant</span></div>
      <div class="bottom-right"><span id="clock">--:--:--</span><span>&middot;</span><span>Running locally</span></div>
    </footer>
  </div>
  <script>
    const listenButton = document.getElementById("listen-button");
    const listenLabel = document.getElementById("listen-label");
    const stateLabel = document.getElementById("state-label");
    const stateMessage = document.getElementById("state-message");
    const heardCommand = document.getElementById("heard-command");
    const voiceValue = document.getElementById("voice-value");
    const connectionLabel = document.getElementById("connection-label");
    const connectionDot = document.getElementById("connection-dot");
    const commandForm = document.getElementById("command-form");
    const commandInput = document.getElementById("command-input");
    const commandSubmit = commandForm.querySelector("button[type='submit']");
    const wakeToggle = document.getElementById("wake-toggle");
    const wakeLabel = document.getElementById("wake-label");
    const voiceSelect = document.getElementById("voice-select");
    const voiceRate = document.getElementById("voice-rate");
    const rateValue = document.getElementById("rate-value");
    const voicePreview = document.getElementById("voice-preview");
    const themeSelect = document.getElementById("theme-select");
    const themeChoices = Array.from(document.querySelectorAll("[data-theme-choice]"));
    const pageTabs = Array.from(document.querySelectorAll("[data-page-target]"));
    const pagePanels = Array.from(document.querySelectorAll("[data-page-panel]"));
    const voicePreferenceKey = "jarvis.speech.voice";
    const ratePreferenceKey = "jarvis.speech.rate";
    const themePreferenceKey = "jarvis.interface.theme";
    const supportedThemes = ["cyan", "amethyst", "emerald", "amber"];
    let availableVoices = [];
    let lastState = "ready";
    let lastSpokenRevision = null;
    let wakeEnabled = false;
    let wakeStopping = false;

    function readPreference(key) {
      try { return window.localStorage.getItem(key); } catch (error) { return null; }
    }

    function savePreference(key, value) {
      try { window.localStorage.setItem(key, value); } catch (error) { /* Preferences remain active for this session. */ }
    }

    function showPage(pageName, focusTab = false) {
      const selectedPanel = pagePanels.find((panel) => panel.dataset.pagePanel === pageName);
      if (!selectedPanel) return;

      for (const panel of pagePanels) {
        const selected = panel === selectedPanel;
        panel.hidden = !selected;
        panel.classList.toggle("is-active", selected);
      }
      for (const tab of pageTabs) {
        const selected = tab.dataset.pageTarget === pageName;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focusTab) tab.focus();
      }
    }

    for (const tab of pageTabs) {
      tab.addEventListener("click", () => showPage(tab.dataset.pageTarget));
      tab.addEventListener("keydown", (event) => {
        const currentIndex = pageTabs.indexOf(tab);
        let nextIndex = currentIndex;
        if (event.key === "ArrowRight") nextIndex = (currentIndex + 1) % pageTabs.length;
        else if (event.key === "ArrowLeft") nextIndex = (currentIndex - 1 + pageTabs.length) % pageTabs.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = pageTabs.length - 1;
        else return;
        event.preventDefault();
        showPage(pageTabs[nextIndex].dataset.pageTarget, true);
      });
    }

    for (const jump of document.querySelectorAll("[data-page-jump]")) {
      jump.addEventListener("click", () => showPage(jump.dataset.pageJump));
    }
    showPage("assistant");

    function applyTheme(theme, persist = true) {
      const selectedTheme = supportedThemes.includes(theme) ? theme : "cyan";
      document.body.dataset.theme = selectedTheme;
      themeSelect.value = selectedTheme;
      for (const choice of themeChoices) {
        choice.setAttribute("aria-pressed", String(choice.dataset.themeChoice === selectedTheme));
      }
      if (persist) savePreference(themePreferenceKey, selectedTheme);
    }

    function voiceKey(voice) {
      return `${voice.voiceURI || voice.name}|${voice.lang}`;
    }

    function populateVoices() {
      if (!("speechSynthesis" in window) || !("SpeechSynthesisUtterance" in window)) {
        voiceSelect.disabled = true;
        voicePreview.disabled = true;
        return;
      }

      const currentValue = voiceSelect.value;
      const savedValue = readPreference(voicePreferenceKey);
      availableVoices = window.speechSynthesis.getVoices()
        .slice()
        .sort((first, second) => `${first.lang} ${first.name}`.localeCompare(`${second.lang} ${second.name}`));

      voiceSelect.replaceChildren(new Option("Automatic · English", ""));
      for (const voice of availableVoices) {
        voiceSelect.add(new Option(`${voice.name} · ${voice.lang || "Unknown"}`, voiceKey(voice)));
      }

      const preferredValue = savedValue || currentValue;
      if (preferredValue && availableVoices.some((voice) => voiceKey(voice) === preferredValue)) {
        voiceSelect.value = preferredValue;
      } else {
        voiceSelect.value = "";
      }
    }

    function updateRateLabel() {
      const rate = Number(voiceRate.value);
      rateValue.value = `${rate.toFixed(2)}×`;
      rateValue.textContent = rateValue.value;
      voiceRate.setAttribute("aria-valuetext", `${rate.toFixed(2)} times normal speed`);
    }

    function selectedSpeechVoice() {
      const selectedKey = voiceSelect.value;
      if (selectedKey) return availableVoices.find((voice) => voiceKey(voice) === selectedKey) || null;
      return availableVoices.find((voice) => voice.lang.toLowerCase() === "en-in")
        || availableVoices.find((voice) => voice.lang.toLowerCase().startsWith("en-"))
        || null;
    }

    function speakResponse(text) {
      if (!text || !("speechSynthesis" in window) || !("SpeechSynthesisUtterance" in window)) return;

      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      const voice = selectedSpeechVoice();
      utterance.lang = voice?.lang || "en-IN";
      utterance.rate = Number(voiceRate.value) || 0.95;
      utterance.pitch = 0.92;

      if (voice) utterance.voice = voice;

      utterance.onstart = () => document.body.classList.add("speaking");
      utterance.onend = () => document.body.classList.remove("speaking");
      utterance.onerror = () => document.body.classList.remove("speaking");
      window.speechSynthesis.speak(utterance);
    }

    voiceSelect.addEventListener("change", () => savePreference(voicePreferenceKey, voiceSelect.value));
    themeSelect.addEventListener("change", () => applyTheme(themeSelect.value));
    for (const choice of themeChoices) {
      choice.addEventListener("click", () => applyTheme(choice.dataset.themeChoice));
    }
    voiceRate.addEventListener("input", () => {
      updateRateLabel();
      savePreference(ratePreferenceKey, voiceRate.value);
    });
    voicePreview.addEventListener("click", () => speakResponse("Hello, I'm Lunar. How can I help you?"));
    if ("speechSynthesis" in window) {
      window.speechSynthesis.addEventListener("voiceschanged", populateVoices);
    }

    const savedRate = Number(readPreference(ratePreferenceKey));
    if (Number.isFinite(savedRate) && savedRate >= Number(voiceRate.min) && savedRate <= Number(voiceRate.max)) {
      voiceRate.value = String(savedRate);
    }
    applyTheme(readPreference(themePreferenceKey) || "cyan", false);
    updateRateLabel();
    populateVoices();

    function renderState(state) {
      const revision = Number(state.revision || 0);
      if (lastSpokenRevision === null) {
        lastSpokenRevision = revision;
      } else if (revision < lastSpokenRevision) {
        lastSpokenRevision = revision;
      } else if (revision > lastSpokenRevision) {
        lastSpokenRevision = revision;
        speakResponse(state.speech_text);
      }

      lastState = state.status || "ready";
      wakeEnabled = Boolean(state.wake_enabled);
      wakeStopping = Boolean(state.wake_stopping);
      document.body.dataset.mode = lastState;
      document.body.classList.toggle("wake-enabled", wakeEnabled);
      wakeToggle.setAttribute("aria-pressed", String(wakeEnabled));
      wakeLabel.textContent = wakeStopping
        ? "Turning off..."
        : wakeEnabled ? "Disable Lunar" : "Enable hands-free";
      stateMessage.textContent = state.message || "Ready for a command";
      heardCommand.textContent = state.heard ? "Heard: " + state.heard : "Say a command to begin.";

      if (lastState === "listening") {
        stateLabel.textContent = "Listening";
        voiceValue.textContent = "Active";
        listenLabel.textContent = "Listening...";
      } else if (lastState === "processing") {
        stateLabel.textContent = "Working";
        voiceValue.textContent = "Working";
        listenLabel.textContent = "Working...";
      } else if (lastState === "error") {
        stateLabel.textContent = "Check microphone";
        voiceValue.textContent = "Attention";
        listenLabel.textContent = "Try again";
      } else if (wakeStopping) {
        stateLabel.textContent = "Stopping";
        voiceValue.textContent = "Stopping";
        listenLabel.textContent = "Please wait";
      } else if (wakeEnabled) {
        stateLabel.textContent = "Listening for Lunar";
        voiceValue.textContent = "Wake on";
        listenLabel.textContent = "Say Lunar";
      } else {
        stateLabel.textContent = "Ready";
        voiceValue.textContent = "Standby";
        listenLabel.textContent = "Listen";
      }

      const busy = lastState === "listening" || lastState === "processing";
      listenButton.disabled = busy || wakeEnabled || wakeStopping;
      wakeToggle.disabled = wakeStopping || (busy && !wakeEnabled);
      commandInput.disabled = wakeEnabled || wakeStopping;
      commandSubmit.disabled = wakeEnabled || wakeStopping;
    }

    async function refreshState() {
      try {
        const response = await fetch("/api/state", { cache: "no-store" });
        if (!response.ok) throw new Error("Local link unavailable");
        renderState(await response.json());
        connectionLabel.textContent = "Connected";
        connectionDot.style.background = "#8cb79a";
        connectionDot.style.boxShadow = "none";
      } catch (error) {
        connectionLabel.textContent = "Offline";
        connectionDot.style.background = "#c58487";
        connectionDot.style.boxShadow = "none";
        stateMessage.textContent = "Reconnect to Lunar";
        listenButton.disabled = true;
        wakeToggle.disabled = true;
      }
    }

    listenButton.addEventListener("click", async () => {
      listenButton.disabled = true;
      try {
        const response = await fetch("/api/listen", { method: "POST" });
        renderState(await response.json());
      } catch (error) {
        stateMessage.textContent = "Offline";
        listenButton.disabled = false;
      }
    });

    wakeToggle.addEventListener("click", async () => {
      wakeToggle.disabled = true;
      try {
        const response = await fetch("/api/wake", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ enabled: !wakeEnabled })
        });
        const state = await response.json();
        renderState(state);
        if (!response.ok) stateMessage.textContent = state.message || "Could not enable hands-free mode";
      } catch (error) {
        wakeToggle.disabled = false;
        stateMessage.textContent = "Offline";
      }
    });

    commandForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const command = commandInput.value.trim();
      if (!command) return;
      listenButton.disabled = true;
      try {
        const response = await fetch("/api/command", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ command })
        });
        renderState(await response.json());
        commandInput.value = "";
      } catch (error) {
        stateMessage.textContent = "Offline";
        listenButton.disabled = false;
      }
    });

    function updateClock() {
      document.getElementById("clock").textContent = new Intl.DateTimeFormat(undefined, {
        hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false
      }).format(new Date());
    }

    updateClock();
    setInterval(updateClock, 1000);
    refreshState();
    setInterval(refreshState, 650);
  </script>
</body>
</html>
